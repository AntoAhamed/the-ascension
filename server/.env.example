# ============================================================================
#  THE ASCENSION — API environment
#  Copy to .env  (cp .env.example .env) and fill in.
#
#  Every value below is MANDATORY. The server validates this file at boot and
#  refuses to start if any required credential is missing, blank, or still the
#  placeholder shipped here. There is no demo mode and no offline fallback.
# ============================================================================

# --- Supabase -------------------------------------------------------------
# Project Settings -> API
# These are the KEYS the BROWSER also needs (put them in client/.env).
SUPABASE_URL=https://your-project-ref.supabase.co

# anon / publishable key — safe to expose; on the server it is used only to
# verify incoming JWTs via auth.getUser()
SUPABASE_ANON_KEY=your-anon-key

# service_role key — NEVER expose this to the browser, and never put it in
# client/.env. It bypasses RLS, so it is effectively full database access.
# Project Settings -> API -> service_role (Legacy)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Google Gemini --------------------------------------------------------
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# --- Server ---------------------------------------------------------------
PORT=4000
NODE_ENV=development

# Comma-separated allowlist of origins permitted to call this API.
# Each entry is a bare origin — scheme, host, optional port, no path. Trailing
# slashes are stripped for you, because the browser's Origin header never has
# one and an unstripped entry would silently match nothing. No wildcards, and
# no plaintext http, when NODE_ENV=production.
#   development: http://localhost:5173
#   production:  https://your-app.vercel.app,https://your-app.com
#
# In development this list is a floor, not a ceiling: any loopback origin on a
# port in Vite's dev range (5173-5199) is also accepted, because Vite picks the
# port at runtime and will move on if 5173 is busy. That fallback does not exist
# in production — a deployed client must be listed here.
#
# This rarely matters in local work anyway, since the client proxies /api in
# development and the browser therefore makes same-origin requests with no CORS
# involved at all. It matters for a remote API, or for `vite preview`.
CORS_ORIGIN=http://localhost:5173

# Shared secret for POST /api/cron/decay. Send it as the `x-cron-secret` header.
#
# REQUIRED when NODE_ENV=production — without it that endpoint mutates every
# profile's points and streak, so the server will refuse to boot rather than
# leave it open. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=change-me-to-a-long-random-string
