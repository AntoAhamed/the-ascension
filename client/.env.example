# ============================================================================
#  THE ASCENSION — client environment
#  Copy to .env  (cp .env.example .env)
#
#  Both values below are safe to expose in the browser: they are the project's
#  public URL and the anon/publishable key. NEVER put the service_role key or
#  the Gemini key in this file — anything here is shipped to every visitor.
# ============================================================================

# Project URL -> Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# "anon" / "publishable" public key (NOT service_role)
VITE_SUPABASE_ANON_KEY=your-anon-key

# Base URL of the Express API — the ORIGIN only, without /api (it is appended
# automatically). You can also include /api; both forms work.
#
# Production: set this to your deployed API origin, e.g. https://api.example.com
# Leave blank only if the API is served behind the same host as the client, in
# which case requests go to /api on the current origin.
#
# Development: a *local* URL like the one below is fine and is what you want.
# The dev server proxies /api to it, so the browser sees a same-origin request
# and CORS never applies — which means a busy port, a shifted dev port, or a
# stale CORS_ORIGIN cannot break your login. You do not have to leave it blank.
#
# The one case that IS cross-origin in development is a remote URL, e.g. a
# staging API. That is honoured as written rather than proxied, so its origin
# must be listed in the server's CORS_ORIGIN. Pointing a "local" value at a
# deployed host would be a mistake: the proxy would quietly redirect it at
# whatever is listening on this machine instead.
VITE_API_URL=http://localhost:4000

# ---------------------------------------------------------------------------
# There is no demo mode.
#
# The server refuses to start without SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY and
# GEMINI_API_KEY, and the client cannot sign anyone in without the two values
# above. There is no local fallback identity, no seeded data, and no offline
# path — an authenticated shell with no real user behind it could not attach
# points, streaks, or a leaderboard row to anyone.
# ---------------------------------------------------------------------------
